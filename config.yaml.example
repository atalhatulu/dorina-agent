# ─────────────────────────────────────────────────────────────
# Dorina Agent — Config Template
# Bu dosya, ~/.dorina/config.yaml oluşmamışsa ilk çalıştırmada
# oraya kopyalanır (core/constants.py → ensure_dorina_home()).
# Gerçek config HER ZAMAN ~/.dorina/config.yaml'dır.
# ─────────────────────────────────────────────────────────────

# Dil (tr | en)
language: tr

# ─── Model Ayarı ───
model:
  default: deepseek/deepseek-v4-flash   # Birincil model
  provider: deepseek                    # Provider adı
  active_model: ''                       # Kullanıcı seçince /setup ile dolar
  fallback_providers:                    # Yedek sağlayıcılar (sırayla)
    - openrouter/openai/gpt-4o-mini
    - ollama/llama3
  context_length: 128000                 # Max context token
  max_tokens: 4096                       # Max yanıt token
  godmode: false
  pricing:                               # Token başına $ maliyet
    default:
      cached_input: 0.000075
      input: 0.00015
      output: 0.0006
    deepseek/deepseek-chat:
      cached_input: 0.00007
      input: 0.00014
      output: 0.00028
    deepseek/deepseek-v4-flash:
      cached_input: 0.00007
      input: 0.00014
      output: 0.00028
    groq/llama3-70b-8192:
      cached_input: 0.0003
      input: 0.00059
      output: 0.00079
    openrouter/anthropic/claude-sonnet-4:
      cached_input: 0.00015
      input: 0.003
      output: 0.015

# ─── Oturum ───
session:
  auto_save: true                         # Her mesajdan sonra otomatik kaydet
  max_sessions: 100
  storage: sqlite

# ─── Bellek ───
memory:
  enabled: true
  auto_extract: true
  max_working_messages: 20
  embedding_model: BAAI/bge-small-en-v1.5
  vector_store: chroma

# ─── Güvenlik ───
security:
  always_allow:                           # Onay istemeyen tool'lar
    - read_file
    - search_files
    - list_directory
    - get_weather
    - get_time
    - web_search
    - get_python_info
    - process_list
  ask_always:                            # Her zaman onay isteyen tool'lar
    - delete_file
    - rm
    - batch_delete
    - execute_code
    - run_script
    - db_execute
    - container_exec
    - bulk_execute_command
  block_destructive_commands: true
  max_code_execution_time: 30
  redact_secrets: true                # Çıktıda sırları maskele

# ─── Arayüz ───
terminal:
  markdown: true
  status_bar: true
  theme: dark

# ─── Kişilik (SOUL.md) ───
soul:
  file: soul.md
  language: tr

# ─── E-posta (send_email aracı) ───
mail:
  imap_server: imap.example.com
  imap_port: 993
  smtp_server: smtp.example.com
  smtp_port: 587
  email_addr: ''
  email_pass: ''

# ─── Skill'ler ───
skills:
  auto_detect: true
  enabled: true
  store_dir: ~/.dorina/skills

# ─── Araçlar ───
tools:
  approval_mode: smart
  default_toolsets:
    - file
    - web
    - terminal
    - git
    - memory
    - delegation
    - cron
    - sandbox
  sandbox: docker                  # none | docker
  mcp_enabled: true
  mcp_servers:
    - name: github
      command: npx
      args:
        - -y
        - '@modelcontextprotocol/server-github'
      env:
        GITHUB_TOKEN: $GITHUB_TOKEN