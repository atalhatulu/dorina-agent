# ─── KÖK DİZİN (ROOT) KISITLAMASI ───
# Kök dizindeki her şeyi yoksay (sadece klasörler ve izin verilen dosyalar hariç)
/*
!/*/

# İzin verilen kök dizin dosyaları (Whitelist)
!.dockerignore
!.gitignore
!CONTRIBUTING.md
!Dockerfile
!FUTURE.md
!LICENSE
!README.md
!app.py
!config.yaml.example
!.env.example
!docker-compose.prod.yml
!docker-compose.yml
!install.ps1
!install.sh
!main.py
!pyproject.toml
!requirements.txt
!run_all_tests.py
!self_restart.py
!setup.py
!soul.md
!start-dorina.sh

# ─── STANDART YOKSAYMALAR ───
# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/
venv/

# Environment
.env
*.env
*.env.*
!.env.example
config.yaml
config.prod.yaml
config.local.yaml
# ─── SIZINTI KORUMASI (alt klasörler dahil) ───
# Kök whitelist (!/*/) tüm klasörleri açar — bu desenler her derinlikte çalışır
**/.env*
!.env.example
**/secrets/
**/keys/
**/credentials*
**/id_rsa*
**/*.pem
**/*.p12
**/*.key
**/*.p8
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.dump
**/*.tar.gz.gpg
**/session_*
**/checkpoints/
**/learned/
**/snapshots/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.code-workspace

# OS
.DS_Store
Thumbs.db
.desktop.ini

# Project data (runtime — asla repo'ya girmez)
data/
sessions/
export/session_*
.backup/
*.bak
*.backup

# Logs
*.log
logs/

# Tests
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Docker
docker-compose.override.yml
docker-compose.local.yml

# Archives / backups
.env.local
.env.production
.env.development

# Claude Code local settings
.claude/

# Graphify
graphify-out/
.graphify_*.json
chunk_*.json
